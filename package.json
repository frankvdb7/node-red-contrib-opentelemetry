{
	"name": "@frankvdb/node-red-contrib-opentelemetry",
	"version": "1.10.0",
	"description": "Full OpenTelemetry support (tracing, metrics, logs) for Node-RED",
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
		"build:test": "node -e \"require('node:fs').rmSync('dist/tests',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
		"prepublishOnly": "npm run build",
		"pack:check": "npm run build && npm pack --dry-run",
		"test": "npm run build && npm run build:test && node --test \"dist/tests/test/*.test.js\"",
		"test:cov": "npm run build && npm run build:test && node --test --experimental-test-coverage \"dist/tests/test/*.test.js\"",
		"fallow": "fallow audit",
		"test:integration": "npm run build && node --test test/integration/*.test.cjs"
	},
	"files": [
		"dist",
		"examples",
		"README.md",
		"LICENSE.md"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"keywords": [
		"node-red",
		"opentelemetry",
		"logging",
		"tracing",
		"metrics",
		"logs",
		"otel",
		"otlp"
	],
	"contributors": [
		"nioc <dev@nioc.eu>",
		"frankvdb7 <5363672+frankvdb7@users.noreply.github.com>"
	],
	"license": "LGPL-3.0-or-later",
	"homepage": "https://github.com/frankvdb7/node-red-contrib-opentelemetry",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frankvdb7/node-red-contrib-opentelemetry.git"
	},
	"bugs": "https://github.com/frankvdb7/node-red-contrib-opentelemetry/issues",
	"publishConfig": {
		"access": "public"
	},
	"node-red": {
		"version": ">=4.0.0",
		"plugins": {
			"opentelemetry-runtime": "dist/plugins/opentelemetry-runtime.js"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@testcontainers/mockserver": "^12.2.1",
		"@types/jmespath": "^0.15.2",
		"@types/node": "^26.6.5",
		"@types/node-red__registry": "^1.3.12",
		"@types/node-red__util": "^5.0.1",
		"fallow": "3.34.1",
		"node-red": "^5.0.9",
		"testcontainers": "^12.2.1",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"node-red": ">=4.0.0"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/api-logs": "^0.223.0",
		"@opentelemetry/core": "^2.12.0",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.300.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
		"@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
		"@opentelemetry/exporter-metrics-otlp-grpc": "^0.223.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
		"@opentelemetry/propagator-b3": "^2.12.0",
		"@opentelemetry/propagator-jaeger": "^2.12.0",
		"@opentelemetry/resources": "^2.12.0",
		"@opentelemetry/sdk-logs": "^0.223.0",
		"@opentelemetry/sdk-metrics": "^2.12.0",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"hash-sum": "2.0.0",
		"jmespath": "^0.16.0"
	}
}
